// Tang Mega 138K Dock C; PMOD0 J9. Official 31005 schematic pages 6/19.
// P19/R19 are SSPI pins and T21/U21 are CPU/SSPI pins; build.tcl releases
// those dedicated functions with use_cpu_as_gpio/use_sspi_as_gpio.
IO_LOC "clk" V22;
IO_PORT "clk" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE;
IO_LOC "reset_key" F4;
IO_PORT "reset_key" IO_TYPE=LVCMOS15 BANK_VCCIO=1.5 PULL_MODE=DOWN;
IO_LOC "pc_tx" U15;
IO_PORT "pc_tx" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE;
IO_LOC "pc_rx" V14;
IO_PORT "pc_rx" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=UP;
IO_LOC "hp_bck" Y17;
IO_PORT "hp_bck" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE;
IO_LOC "hp_ws" AB17;
IO_PORT "hp_ws" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE;
IO_LOC "hp_din" AA16;
IO_PORT "hp_din" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE;
IO_LOC "pa_en" AB16;
IO_PORT "pa_en" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE;
IO_LOC "imu_data" P19;
IO_PORT "imu_data" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=UP;
IO_LOC "imu_clk_tx" R19;
IO_PORT "imu_clk_tx" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE;
IO_LOC "imu_mosi" T21;
IO_PORT "imu_mosi" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE;
IO_LOC "imu_cs_n" U21;
IO_PORT "imu_cs_n" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE;
IO_LOC "imu_int_n" P16;
IO_PORT "imu_int_n" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=UP;
IO_LOC "imu_rst_n" R17;
IO_PORT "imu_rst_n" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE;
IO_LOC "imu_wake" R18;
IO_PORT "imu_wake" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE;
IO_LOC "event_mark" T18;
IO_PORT "event_mark" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE;
IO_LOC "audio_mark" AA20;
IO_PORT "audio_mark" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE;

