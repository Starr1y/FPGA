// NEO Rev1.4 PDF pages7/10/19. No SPI outputs, no GPIO power-good bypass.
IO_LOC "clk" V22;
IO_PORT "clk" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE;
IO_LOC "reset_key" F4;
IO_PORT "reset_key" IO_TYPE=LVCMOS15 BANK_VCCIO=1.5 PULL_MODE=DOWN;
IO_LOC "key0_n" AA13;
IO_PORT "key0_n" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=UP;
IO_LOC "key1_n" Y12;
IO_PORT "key1_n" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=UP;
IO_LOC "key2_n" AB13;
IO_PORT "key2_n" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=UP;
IO_LOC "imu_scl[0]" E19;
IO_PORT "imu_scl[0]" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE;
IO_LOC "imu_scl[1]" D19;
IO_PORT "imu_scl[1]" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE;
IO_LOC "imu_sda[0]" C18;
IO_PORT "imu_sda[0]" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE;
IO_LOC "imu_sda[1]" C19;
IO_PORT "imu_sda[1]" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE;
IO_LOC "wrist_button2_n[0]" E16;
IO_PORT "wrist_button2_n[0]" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=UP;
IO_LOC "wrist_button2_n[1]" E17;
IO_PORT "wrist_button2_n[1]" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=UP;
IO_LOC "hp_bck" Y17;
IO_PORT "hp_bck" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE;
IO_LOC "hp_ws" AB17;
IO_PORT "hp_ws" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE;
IO_LOC "hp_din" AA16;
IO_PORT "hp_din" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE;
IO_LOC "pa_en" AB16;
IO_PORT "pa_en" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE;
IO_LOC "tmds_d_p_0[0]" J14,H14;
IO_PORT "tmds_d_p_0[0]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_d_p_0[1]" J15,H15;
IO_PORT "tmds_d_p_0[1]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_d_p_0[2]" K17,J17;
IO_PORT "tmds_d_p_0[2]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_clk_p_0" G15,G16;
IO_PORT "tmds_clk_p_0" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;



IO_LOC "pc_tx" U15;
IO_PORT "pc_tx" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE;
IO_LOC "pc_rx" V14;
IO_PORT "pc_rx" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=UP;

// EC11: verified against existing DUO03 pin allocation; see wiring guide.
IO_LOC "encoder_a" E14;
IO_PORT "encoder_a" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=UP;
IO_LOC "encoder_b" E13;
IO_PORT "encoder_b" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=UP;
IO_LOC "encoder_button_n" C15;
IO_PORT "encoder_button_n" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=UP;

// Arora V SUG1018 section2.7: preserve dedicated distribution for actual
// PLL-derived clocks. V22 is the fixed reference input; do not move its pin
// or suppress PR1014. Validate reference routing in the user's final PNR.
CLOCK_LOC "core_clk" BUFG = CLK;
CLOCK_LOC "pixel_clk" BUFG = CLK;
CLOCK_LOC "serial_clk" BUFG = CLK;
// Explicit common reference buffer feeds both PLLs. Fixed V22 input retained.
// Final PNR must confirm dedicated routing; this constraint is not proof.
CLOCK_LOC "reference_clock" BUFG = CLK;

// External Philips I2S, 16-bit slots, 48 kHz, BCLK=32fs, no MCLK.
// J13.4/.5/.6. Disconnect legacy DUO03 pedal/wrist inputs from these pins.
IO_LOC "i2s_bck" C14;
IO_PORT "i2s_bck" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE DRIVE=4;
IO_LOC "i2s_ws" B13;
IO_PORT "i2s_ws" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE DRIVE=4;
IO_LOC "i2s_dout" C13;
IO_PORT "i2s_dout" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE DRIVE=4;


// Wrist dry-contact switches, NEO31005 A5/A6 on J13.25/.26.
IO_LOC "wrist_button_n[0]" D15;
IO_PORT "wrist_button_n[0]" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=UP;
IO_LOC "wrist_button_n[1]" D14;
IO_PORT "wrist_button_n[1]" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=UP;
