{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tanglab:score:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "title",
    "tempo_bpm",
    "ticks_per_quarter",
    "steps"
  ],
  "properties": {
    "format": {
      "const": "tanglab.score"
    },
    "version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "tempo_bpm": {
      "type": "integer",
      "minimum": 20,
      "maximum": 300
    },
    "ticks_per_quarter": {
      "const": 480
    },
    "warnings": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "maxLength": 512
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hand",
          "midi",
          "duration_ticks"
        ],
        "properties": {
          "hand": {
            "enum": [
              "left",
              "right"
            ]
          },
          "midi": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "duration_ticks": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30720
          },
          "rest_before_ticks": {
            "type": "integer",
            "minimum": 0,
            "maximum": 30720
          },
          "original_midi": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          }
        }
      }
    }
  }
}