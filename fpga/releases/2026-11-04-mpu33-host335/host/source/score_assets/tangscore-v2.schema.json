{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "title",
    "tempo_bpm",
    "steps"
  ],
  "properties": {
    "format": {
      "const": "tanglab.score"
    },
    "version": {
      "const": 2
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "tempo_bpm": {
      "type": "integer",
      "minimum": 20,
      "maximum": 300
    },
    "warnings": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "maxLength": 512
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hand",
          "midi",
          "hold_ms"
        ],
        "properties": {
          "hand": {
            "enum": [
              "left",
              "right"
            ]
          },
          "midi": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "hold_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60000
          },
          "rest_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 60000
          }
        }
      }
    }
  }
}