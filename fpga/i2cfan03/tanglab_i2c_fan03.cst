// SPI: SDA/MISO C18, SCL/SCK E19, ADO/MOSI F15, CS F16, INT E16, RST D20, PS0/WAKE D14.
// Tang Mega 138K Dock C / NEO; IMU on photographed SDRAM0 long header.
// C18/E19/D20/E16 match the official bank-2 SDRAM0 GPIO constraints.
// P19/R19 are SSPI pins and T21/U21 are CPU/SSPI pins; build.tcl releases
// those dedicated functions with use_cpu_as_gpio/use_sspi_as_gpio.
IO_LOC "clk" V22;
IO_PORT "clk" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE;
IO_LOC "reset_key" F4;
IO_PORT "reset_key" IO_TYPE=LVCMOS15 BANK_VCCIO=1.5 PULL_MODE=DOWN;
// Dock C USER_BUTTON1 / USER_BUTTON2 (EX_KEY.1 / EX_KEY.2), active low.
IO_LOC "key0_n" AA13;
IO_PORT "key0_n" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=UP;
IO_LOC "key1_n" AB13;
IO_PORT "key1_n" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=UP;
IO_LOC "key2_n" Y12;
IO_PORT "key2_n" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=UP;
IO_LOC "pc_tx" U15;
IO_PORT "pc_tx" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE;
IO_LOC "pc_rx" V14;
IO_PORT "pc_rx" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=UP;
IO_LOC "hp_bck" Y17;
IO_PORT "hp_bck" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE;
IO_LOC "hp_ws" AB17;
IO_PORT "hp_ws" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE;
IO_LOC "hp_din" AA16;
IO_PORT "hp_din" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE;
IO_LOC "pa_en" AB16;
IO_PORT "pa_en" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE;
IO_LOC "imu_data" C18;
IO_PORT "imu_data" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE;
IO_LOC "imu_clk_tx" E19;
IO_PORT "imu_clk_tx" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE;
IO_LOC "imu_mosi" F15;
IO_PORT "imu_mosi" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE;
IO_LOC "imu_cs_n" F16;
IO_PORT "imu_cs_n" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE;
IO_LOC "imu_int_n" E16;
IO_PORT "imu_int_n" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE;
// Unused in this manual bench profile. Leave D15 disconnected.
IO_LOC "imu_power_good" D15;
IO_PORT "imu_power_good" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=DOWN;
IO_LOC "imu_rst_n" D20;
IO_PORT "imu_rst_n" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE;
IO_LOC "imu_wake" D14;
IO_PORT "imu_wake" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE;
IO_LOC "event_mark" T18;
IO_PORT "event_mark" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE;
IO_LOC "audio_mark" AA20;
IO_PORT "audio_mark" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3 PULL_MODE=NONE;

// Tang Mega 138K ordinary Dock C HDMI differential pairs (official_pins.cst).
IO_LOC "tmds_d_p_0[0]" J14,H14;
IO_PORT "tmds_d_p_0[0]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_d_p_0[1]" J15,H15;
IO_PORT "tmds_d_p_0[1]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_d_p_0[2]" K17,J17;
IO_PORT "tmds_d_p_0[2]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_clk_p_0" G15,G16;
IO_PORT "tmds_clk_p_0" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;


